{
  "schemaVersion": "v1",
  "obotSentryVersion": "${VERSION}",
  "fields": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "serverURL"
    ],
    "properties": {
      "serverURL": {
        "type": "string",
        "format": "uri",
        "readOnly": true,
        "hidden": true,
        "description": "Obot server base URL (supplied by obot, not the admin)"
      },
      "scanIntervalMinutes": {
        "type": "integer",
        "minimum": 15,
        "maximum": 1440,
        "default": 60,
        "title": "Scan interval (minutes)",
        "description": "How often each signed-in user's device submits a scan."
      }
    }
  },
  "platforms": [
    {
      "id": "intune",
      "label": "Microsoft Intune"
    }
  ],
  "configurations": [
    {
      "platform": "intune",
      "os": "windows",
      "osLabel": "Windows",
      "description": "Deploy Obot Sentry to a Windows fleet with Microsft Intune",
      "suggestedName": "Windows Fleet",
      "instructions": "windows/intune/INSTRUCTIONS.md.tmpl",
      "assets": [
        "windows/intune/obot-sentry.intunewin",
        "windows/intune/INSTRUCTIONS.md.tmpl"
      ]
    }
  ]
}
