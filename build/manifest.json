{
  "schemaVersion": "v1",
  "obotSentryVersion": "${VERSION}",
  "fields": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "serverURL"
    ],
    "properties": {
      "serverURL": {
        "type": "string",
        "format": "uri",
        "readOnly": true,
        "hidden": true,
        "description": "Obot server base URL (supplied by obot, not the admin)"
      },
      "scanIntervalMinutes": {
        "type": "integer",
        "minimum": 15,
        "maximum": 1440,
        "default": 60,
        "title": "Scan interval (minutes)",
        "description": "How often each signed-in user's device submits a scan."
      }
    }
  },
  "platforms": [
    {
      "id": "manual",
      "label": "Do it Yourself"
    },
    {
      "id": "intune",
      "label": "Microsoft Intune"
    },
    {
      "id": "jamf",
      "label": "Jamf Pro"
    }
  ],
  "configurations": [
    {
      "platform": "intune",
      "os": "windows",
      "osLabel": "Windows",
      "description": "Deploy Obot Sentry to Windows devices with Microsoft Intune",
      "suggestedName": "Windows Devices",
      "instructions": "windows/intune/INSTRUCTIONS.md.tmpl",
      "assets": [
        "windows/intune/obot-sentry.intunewin",
        "windows/intune/INSTRUCTIONS.md.tmpl"
      ]
    },
    {
      "platform": "intune",
      "os": "macos",
      "osLabel": "macOS",
      "description": "Deploy Obot Sentry to macOS devices with Microsoft Intune",
      "suggestedName": "macOS Devices",
      "instructions": "macos/intune/INSTRUCTIONS.md.tmpl",
      "assets": [
        "macos/obot-sentry-${VERSION}.pkg",
        "macos/ai.obot.obot-sentry.mobileconfig.tmpl",
        "macos/ai.obot.obot-sentry.pppc.mobileconfig",
        "macos/uninstall.sh",
        "macos/intune/INSTRUCTIONS.md.tmpl"
      ]
    },
    {
      "platform": "jamf",
      "os": "macos",
      "osLabel": "macOS",
      "description": "Deploy Obot Sentry to macOS devices with Jamf Pro",
      "suggestedName": "macOS Devices",
      "instructions": "macos/jamf/INSTRUCTIONS.md.tmpl",
      "assets": [
        "macos/obot-sentry-${VERSION}.pkg",
        "macos/ai.obot.obot-sentry.mobileconfig.tmpl",
        "macos/ai.obot.obot-sentry.pppc.mobileconfig",
        "macos/uninstall.sh",
        "macos/jamf/INSTRUCTIONS.md.tmpl"
      ]
    },
    {
      "platform": "manual",
      "os": "windows",
      "osLabel": "Windows",
      "description": "Install Obot Sentry directly on Windows without an MDM",
      "suggestedName": "Windows Devices",
      "instructions": "windows/manual/INSTRUCTIONS.md.tmpl",
      "assets": [
        "windows/manual/obot-sentry.msi",
        "windows/manual/obot-sentry.exe",
        "windows/manual/INSTRUCTIONS.md.tmpl"
      ]
    },
    {
      "platform": "manual",
      "os": "macos",
      "osLabel": "macOS",
      "description": "Install Obot Sentry directly on macOS without an MDM",
      "suggestedName": "macOS Devices",
      "instructions": "macos/manual/INSTRUCTIONS.md.tmpl",
      "assets": [
        "macos/obot-sentry-${VERSION}.pkg",
        "macos/manual/obot-sentry",
        "macos/uninstall.sh",
        "macos/manual/INSTRUCTIONS.md.tmpl"
      ]
    }
  ]
}
