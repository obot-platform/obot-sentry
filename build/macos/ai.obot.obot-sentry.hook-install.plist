<?xml version="1.0" encoding="UTF-8"?>
<!--
	Converges the managed local-agent hooks as root, for machine policy and
	every local user. RunAtLoad covers boot and installation. The five-minute
	StartInterval poll is cheap: with the if-due flag, obot-sentry converges
	only when HookIntervalMinutes has elapsed or something relevant changed.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>ai.obot.obot-sentry.hook-install</string>

	<key>ProgramArguments</key>
	<array>
		<string>/usr/local/bin/obot-sentry</string>
		<string>hook-install</string>
		<string>--if-due</string>
	</array>

	<key>RunAtLoad</key>
	<true/>

	<key>StartInterval</key>
	<integer>300</integer>
</dict>
</plist>
